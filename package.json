{
  "name": "ag-client-typescript",
  "version": "0.0.0-dev0",
  "description": "A client for interacting with the autograder.io API.",
  "scripts": {
    "clean": "rm -rf ./dist",
    "test": "tsc -p . --noEmit && ./node_modules/.bin/jest --runInBand",
    "lint": "tsc -p . --noEmit && eslint './src/**/*.ts' './tests/**/*.ts'",
    "build": "tsc -p .",
    "build:clean": "npm run clean && npm ci && npm run build"
  },
  "author": "James Perretta",
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/eecs-autograder/ag-client-typescript"
  },
  "devDependencies": {
    "@types/jest": "^28.1.8",
    "@types/node": "^10.17.54",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-deprecation": "^3.0.0",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "ts-jest": "^28.0.0",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "axios": "^0.21.1"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
